{
  "name": "ntp-gallery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browse, search and fetch Chrome / ego new-tab-page wallpaper collections",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "python3 api/server.py",
    "dev:web": "vite",
    "build": "pnpm paraglide && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm paraglide && tsc --noEmit",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "fetch": "python3 api/cli.py"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "packageManager": "pnpm@10.33.0"
}
